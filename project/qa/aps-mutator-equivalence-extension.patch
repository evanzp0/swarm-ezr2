+                                 "                                   :output \"\"\n"
+                                 "                                   :error \"\"\n"
+                                 "                                   :duration 1}))\n"
+                                 "    (flush)))\n"))
+                      (str path))
+        entry (balance-filter-entry dir)
+        filter-path (write-filter-file! dir [entry])
+        filter-spec (mutation/load-equivalence-filter filter-path)]
+    (spit feature-path
+          (str "Feature: Withdrawals\n"
+               "Background:\n"
+               "Given an account balance of <balance>\n"
+               "Scenario Outline: Withdraw cash\n"
+               "When the customer withdraws <amount>\n"
+               "Examples:\n"
+               "| balance | amount | remaining |\n"
+               "| 100 | 20 | 80 |\n"))
+    (let [report (mutation/run {:feature (gherkin-parse feature-path)
+                                :feature-path feature-path
+                                :work-dir (str (io/file dir "work"))
+                                :workers 1
+                                :status-interval-ms 0
+                                :runner-command ["bb" kill-worker]
+                                :equivalence-filter filter-spec})]
+      (is (= {:Total 2 :Killed 2 :Survived 0 :Errors 0 :FilteredEquivalents 1} (:summary report)))
+      (mutation/write-mutation-metadata! feature-path (gherkin-parse feature-path) report
+                                         "impl-hash" "hard" true filter-spec)
+      (let [manifest (read-manifest feature-path)
+            scenario-entry (get-in manifest [:scenarios 0])]
+        (is (= (:hash filter-spec) (:equivalence_filter_hash manifest)))
+        (is (= 2 (:mutation_count scenario-entry)))
+        (is (= 1 (get-in scenario-entry [:result :FilteredEquivalents])))
+        (is (zero? (get-in scenario-entry [:result :Survived]))))
+      (testing "same filter reuses the scenario"
+        (let [rerun (mutation/run {:feature (gherkin-parse feature-path)
+                                   :feature-path feature-path
+                                   :work-dir (str (io/file dir "work2"))
+                                   :workers 1
