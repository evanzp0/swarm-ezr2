+(defn load-equivalence-filter [path]
+  (let [content (slurp path)
+        data (try
+               (json/parse-string content true)
+               (catch Exception _
+                 (throw (ex-info (str "equivalence filter " path " is not valid JSON") {}))))]
+    (when-not (map? data)
+      (throw (ex-info (str "equivalence filter " path " must be a JSON object") {})))
+    (when-not (= 1 (:version data))
+      (throw (ex-info (str "equivalence filter " path " must declare version 1") {})))
+    (when-not (vector? (:equivalences data))
+      (throw (ex-info (str "equivalence filter " path " must contain an equivalences array") {})))
+    (doseq [entry (:equivalences data)]
+      (when-not (and (map? entry)
+                     (seq (str (:feature entry)))
+                     (seq (str (:path entry)))
+                     (seq (str (:original entry)))
+                     (seq (str (:mutated entry))))
+        (throw (ex-info (str "equivalence filter " path " entries require feature, path, original, and mutated") {})))
+      (when-not (re-find #"^\$\.scenarios\[\d+\]\.examples\[\d+\]\.\S+$" (str (:path entry)))
+        (throw (ex-info (str "equivalence filter " path " entry path must be $.scenarios[i].examples[j].<key>, got: " (:path entry)) {}))))
+    {:path path :data data :hash (sha256 content)}))
+
+(defn- feature-stem [feature-path]
+  (let [name (.getName (io/file feature-path))]
+    (if (str/ends-with? name ".feature")
+      (subs name 0 (- (count name) (count ".feature")))
+      name)))
+
+(defn- filter-entry-match [filter-spec feature-path mutation]
+  (when (and filter-spec feature-path)
+    (let [stem (feature-stem feature-path)]
+      (some #(when (and (= (str (:feature %)) stem)
+                        (= (str (:path %)) (:Path mutation))
+                        (= (str (:original %)) (str (:Original mutation)))
+                        (= (str (:mutated %)) (str (:Mutated mutation))))
+               %)
+            (get-in filter-spec [:data :equivalences])))))
+
+(defn- filtered-ids [filter-spec feature-path mutations]
+  (if filter-spec
+    (set (map :ID (filter #(filter-entry-match filter-spec feature-path %) mutations)))
+    #{}))
+
+(defn- equivalent-view [mutation entry]
+  (array-map :ID (:ID mutation)
+             :Path (:Path mutation)
+             :Description (:Description mutation)
+             :Original (:Original mutation)
+             :Mutated (:Mutated mutation)
+             :Class (str (:class entry))
+             :Justification (str (:justification entry))
+             :Invalidation (str (:invalidation entry))
+             :scenario (:scenario mutation)))
+
+(defn- stamp-hash [cleaned filter-hash]
+  (if filter-hash
+    (sha256 (str cleaned "\n# equivalence-filter: " filter-hash))
+    (sha256 cleaned)))
