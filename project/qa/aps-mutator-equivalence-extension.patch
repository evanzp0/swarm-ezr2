+(defn- write-filter-file! [dir equivalences]
+  (let [path (str (io/file dir "filter.json"))]
+    (spit path (json/generate-string {:version 1 :equivalences equivalences}))
+    path))
+
+(defn- balance-filter-entry [dir]
+  (let [balance-mut (some #(when (= "$.scenarios[0].examples[0].balance" (:Path %)) %)
+                          (mutation/discover mutation-feature))]
+    {:feature "withdrawals"
+     :path (:Path balance-mut)
+     :original (:Original balance-mut)
+     :mutated (:Mutated balance-mut)
+     :class "value-mirror"
+     :justification "assertions derive from the mutated value"
+     :invalidation "product validates the value"}))
+
+(defn- gherkin-parse [path]
+  (gherkin/parse-file path))
+
+(defn- read-manifest [feature-path]
+  (let [lines (str/split-lines (slurp feature-path))
+        manifest-lines (rest (take-while #(not= (str/trim %) "# acceptance-mutation-manifest-end")
+                                         (drop-while #(not= (str/trim %) "# acceptance-mutation-manifest-begin")
+                                                     lines)))]
+    (json/parse-string (str/join "" (mapv #(subs (str/trim %) 1) manifest-lines)) true)))
+
+(deftest equivalence-filter-loader-rejects-malformed-documents
+  (let [dir (.toFile (temp-dir))
+        bad-json (str (io/file dir "bad-json.json"))
+        bad-version (str (io/file dir "bad-version.json"))
+        missing-field (str (io/file dir "missing-field.json"))
+        bad-path (str (io/file dir "bad-path.json"))]
+    (spit bad-json "{not json")
+    (spit bad-version (json/generate-string {:version 2 :equivalences []}))
+    (spit missing-field (json/generate-string {:version 1 :equivalences [{:feature "f" :path "$.scenarios[0].examples[0].k"}]}))
+    (spit bad-path (json/generate-string {:version 1 :equivalences [{:feature "f" :path "scenarios[0]" :original "1" :mutated "2"}]}))
+    (is (thrown? Exception (mutation/load-equivalence-filter bad-json)))
+    (is (thrown? Exception (mutation/load-equivalence-filter bad-version)))
+    (is (thrown? Exception (mutation/load-equivalence-filter missing-field)))
+    (is (thrown? Exception (mutation/load-equivalence-filter bad-path)))
+    (let [ok (write-filter-file! dir [(balance-filter-entry dir)])
+          loaded (mutation/load-equivalence-filter ok)]
+      (is (= 1 (count (get-in loaded [:data :equivalences]))))
+      (is (seq (:hash loaded))))))
+
+(deftest run-with-equivalence-filter-excludes-matching-mutations
+  (let [dir (.toFile (temp-dir))
+        worker (worker-script dir)
+        filter-path (write-filter-file! dir [(balance-filter-entry dir)])
+        filter-spec (mutation/load-equivalence-filter filter-path)
+        report (mutation/run {:feature mutation-feature
+                              :feature-path "/tmp/withdrawals.feature"
+                              :work-dir (str (io/file dir "work"))
+                              :workers 1
+                              :status-interval-ms 0
+                              :runner-command ["bb" worker]
+                              :equivalence-filter filter-spec})]
+    (is (= {:Total 2 :Killed 1 :Survived 0 :Errors 1 :FilteredEquivalents 1}
+           (:summary report)))
+    (is (= ["m1" "m3"] (mapv #(get-in % [:Mutation :ID]) (:results report))))
+    (is (= ["m2"] (mapv :ID (:filtered report))))
+    (is (= "$.scenarios[0].examples[0].balance" (get-in report [:filtered 0 :Path])))
+    (is (= "value-mirror" (get-in report [:filtered 0 :Class])))
+    (is (= (:hash filter-spec) (:filter-hash report)))))
+
+(deftest filtered-run-writes-filter-aware-metadata-and-reuses-only-same-filter
+  (let [dir (.toFile (temp-dir))
+        feature-path (str (io/file dir "withdrawals.feature"))
+        worker (worker-script dir)
+        kill-worker (let [path (io/file dir "kill-worker.clj")]
