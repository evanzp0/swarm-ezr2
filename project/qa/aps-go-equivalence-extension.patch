+++ b/internal/mutation/equivalence_test.go
@@ -0,0 +1,208 @@
+package mutation
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"acceptance-pipeline-specification/internal/gherkin"
+)
+
+func writeFilterFile(t *testing.T, dir string, equivalences []EquivalenceEntry) string {
+	t.Helper()
+	path := filepath.Join(dir, "filter.json")
+	doc := map[string]interface{}{"version": 1, "equivalences": equivalences}
+	data, err := json.Marshal(doc)
+	if err != nil {
+		t.Fatalf("marshal filter: %v", err)
+	}
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		t.Fatalf("write filter: %v", err)
+	}
+	return path
+}
+
+func sampleFilterFeature() gherkin.Feature {
+	return gherkin.Feature{
+		Name: "Balance",
+		Scenarios: []gherkin.Scenario{{
+			Name: "S",
+			Steps: []gherkin.Step{{
+				Keyword:    "Then",
+				Text:       "balance is <balance>",
+				Parameters: []string{"balance"},
+			}},
+			Examples: []map[string]string{{
+				"balance": "100",
+				"amount":  "20",
+			}},
+		}},
+	}
+}
+
+func TestLoadEquivalenceFilterValidatesContract(t *testing.T) {
+	dir := t.TempDir()
+	path := writeFilterFile(t, dir, []EquivalenceEntry{{
+		Feature:  "probe",
+		Path:     "$.scenarios[0].examples[0].balance",
+		Original: "100",
+		Mutated:  "109",
+		Class:    "input-mirror",
+	}})
+	filter, err := LoadEquivalenceFilter(path)
+	if err != nil {
+		t.Fatalf("load failed: %v", err)
+	}
+	if filter.Hash == "" {
+		t.Fatalf("filter hash empty")
+	}
+	if len(filter.Data.Equivalences) != 1 {
+		t.Fatalf("equivalences = %d", len(filter.Data.Equivalences))
+	}
+
+	badPath := filepath.Join(dir, "bad.json")
+	if err := os.WriteFile(badPath, []byte(`{"version": 2, "equivalences": []}`), 0o644); err != nil {
+		t.Fatalf("write bad filter: %v", err)
+	}
+	if _, err := LoadEquivalenceFilter(badPath); err == nil {
+		t.Fatalf("version 2 accepted")
+	}
+
+	missingPath := filepath.Join(dir, "missing.json")
+	if err := os.WriteFile(missingPath, []byte(`{"version": 1, "equivalences": [{"feature": "f", "path": "$.scenarios[0].examples[0].x", "original": "1"}]}`), 0o644); err != nil {
+		t.Fatalf("write missing-field filter: %v", err)
+	}
+	if _, err := LoadEquivalenceFilter(missingPath); err == nil {
+		t.Fatalf("entry without mutated accepted")
+	}
+
+	badPathShape := filepath.Join(dir, "shape.json")
+	if err := os.WriteFile(badPathShape, []byte(`{"version": 1, "equivalences": [{"feature": "f", "path": "scenarios[0]", "original": "1", "mutated": "2"}]}`), 0o644); err != nil {
+		t.Fatalf("write bad-shape filter: %v", err)
+	}
+	if _, err := LoadEquivalenceFilter(badPathShape); err == nil {
+		t.Fatalf("non-jsonpath entry accepted")
+	}
+}
+
+func TestFilterEntryMatchRequiresFullQuadruple(t *testing.T) {
+	dir := t.TempDir()
+	path := writeFilterFile(t, dir, []EquivalenceEntry{{
+		Feature:  "probe",
+		Path:     "$.scenarios[0].examples[0].balance",
+		Original: "100",
+		Mutated:  "109",
+	}})
+	filter, err := LoadEquivalenceFilter(path)
+	if err != nil {
+		t.Fatalf("load failed: %v", err)
+	}
+	featurePath := "features/probe.feature"
+	mutations := Discover(sampleFilterFeature())
+
+	positive := mutations[0]
+	if positive.Path != "$.scenarios[0].examples[0].amount" {
+		t.Fatalf("unexpected first mutation path %s", positive.Path)
+	}
+	if filterEntryMatch(filter, featurePath, positive) != nil {
+		t.Fatalf("non-listed cell matched")
+	}
+
+	var balance Mutation
+	for _, m := range mutations {
+		if m.Key == "balance" {
+			balance = m
+		}
+	}
+	if filterEntryMatch(filter, featurePath, balance) != nil {
+		t.Fatalf("matched with wrong mutated value: %s", balance.Mutated)
+	}
+
+	balance.Mutated = "109"
+	if filterEntryMatch(filter, featurePath, balance) == nil {
+		t.Fatalf("exact quadruple not matched")
+	}
+
+	if filterEntryMatch(filter, "features/other.feature", balance) != nil {
+		t.Fatalf("wrong stem matched")
+	}
+}
+
+func TestRunWithFilterExcludesFilteredFromTotalAndExecutesRest(t *testing.T) {
+	dir := t.TempDir()
+	feature := sampleFilterFeature()
+	mutations := Discover(feature)
+	var balance Mutation
+	for _, m := range mutations {
+		if m.Key == "balance" {
+			balance = m
+		}
+	}
+	path := writeFilterFile(t, dir, []EquivalenceEntry{{
+		Feature:  "Balance",
+		Path:     balance.Path,
+		Original: balance.Original,
+		Mutated:  balance.Mutated,
+		Class:    "input-mirror",
+		Justification: "j",
+	}})
+	filter, err := LoadEquivalenceFilter(path)
+	if err != nil {
+		t.Fatalf("load failed: %v", err)
+	}
+
+	var killed []string
+	runner := RunnerFunc(func(_ context.Context, job Job) RunnerResult {
+		killed = append(killed, job.Mutation.ID)
+		return RunnerResult{Outcome: TestFailure}
+	})
+	report, err := Run(context.Background(), Config{
+		Feature:           feature,
+		FeaturePath:       "features/Balance.feature",
+		WorkDir:           filepath.Join(dir, "work"),
+		Level:             "full",
+		EquivalenceFilter: filter,
+	}, runner)
+	if err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	if report.Summary.Total != 1 {
+		t.Fatalf("total = %d, want 1 (one cell filtered)", report.Summary.Total)
+	}
+	if report.Summary.FilteredEquivalents != 1 {
+		t.Fatalf("filtered = %d", report.Summary.FilteredEquivalents)
+	}
+	if report.Summary.Killed != 1 || report.Summary.Survived != 0 {
+		t.Fatalf("killed=%d survived=%d", report.Summary.Killed, report.Summary.Survived)
+	}
+	if report.FilterHash != filter.Hash {
+		t.Fatalf("filter-hash not propagated")
+	}
+	if len(report.Filtered) != 1 || report.Filtered[0].Class != "input-mirror" {
+		t.Fatalf("filtered view incomplete: %#v", report.Filtered)
+	}
+
+	text := &strings.Builder{}
+	if err := WriteTextReport(text, report); err != nil {
+		t.Fatalf("text report: %v", err)
+	}
+	if !strings.Contains(text.String(), "filtered_equivalents=1") || !strings.Contains(text.String(), "filtered equivalents (not executed):") {
+		t.Fatalf("text report missing filtered section:\n%s", text.String())
+	}
+}
+
+func TestStampHashIncorporatesFilterHash(t *testing.T) {
+	cleaned := "# content\nfeature body"
+	plain := stampHash(cleaned, "")
+	withFilter := stampHash(cleaned, "deadbeef")
+	if plain == withFilter {
+		t.Fatalf("filter hash not mixed into stamp")
