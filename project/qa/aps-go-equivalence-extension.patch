index 0000000..fbece57
--- /dev/null
+++ b/internal/mutation/equivalence.go
@@ -0,0 +1,137 @@
+package mutation
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"regexp"
+	"strings"
+)
+
+type EquivalenceEntry struct {
+	Feature      string `json:"feature"`
+	Path         string `json:"path"`
+	Original     string `json:"original"`
+	Mutated      string `json:"mutated"`
+	Class        string `json:"class"`
+	Justification string `json:"justification"`
+	Invalidation string `json:"invalidation"`
+}
+
+type equivalenceFilterData struct {
+	Version      int                `json:"version"`
+	Equivalences []EquivalenceEntry `json:"equivalences"`
+}
+
+type EquivalenceFilter struct {
+	Path string
+	Data equivalenceFilterData
+	Hash string
+}
+
+var equivalencePathPattern = regexp.MustCompile(`^\$\.scenarios\[\d+\]\.examples\[\d+\]\.\S+$`)
+
+func LoadEquivalenceFilter(path string) (*EquivalenceFilter, error) {
+	contentBytes, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("equivalence filter %s unreadable: %w", path, err)
+	}
+	content := string(contentBytes)
+	var data equivalenceFilterData
+	if err := json.Unmarshal([]byte(content), &data); err != nil {
+		return nil, fmt.Errorf("equivalence filter %s is not valid JSON: %w", path, err)
+	}
+	if data.Version != 1 {
+		return nil, fmt.Errorf("equivalence filter %s must declare version 1", path)
+	}
+	if data.Equivalences == nil {
+		return nil, fmt.Errorf("equivalence filter %s must contain an equivalences array", path)
+	}
+	for i, entry := range data.Equivalences {
+		if entry.Feature == "" || entry.Path == "" || entry.Original == "" || entry.Mutated == "" {
+			return nil, fmt.Errorf("equivalence filter %s entries require feature, path, original, and mutated (entry %d)", path, i)
+		}
+		if !equivalencePathPattern.MatchString(entry.Path) {
+			return nil, fmt.Errorf("equivalence filter %s entry path must be $.scenarios[i].examples[j].<key>, got: %s", path, entry.Path)
+		}
+	}
+	sum := sha256.Sum256([]byte(content))
+	return &EquivalenceFilter{
+		Path: path,
+		Data: data,
+		Hash: hex.EncodeToString(sum[:]),
+	}, nil
+}
+
+func featureStem(featurePath string) string {
+	name := featurePath
+	if idx := strings.LastIndexAny(name, "/\\"); idx >= 0 {
+		name = name[idx+1:]
+	}
+	return strings.TrimSuffix(name, ".feature")
+}
+
+func filterEntryMatch(filter *EquivalenceFilter, featurePath string, mutation Mutation) *EquivalenceEntry {
+	if filter == nil || featurePath == "" {
+		return nil
+	}
+	stem := featureStem(featurePath)
+	for i := range filter.Data.Equivalences {
+		entry := &filter.Data.Equivalences[i]
+		if entry.Feature == stem &&
+			entry.Path == mutation.Path &&
+			entry.Original == mutation.Original &&
+			entry.Mutated == mutation.Mutated {
+			return entry
+		}
+	}
+	return nil
+}
+
+func filteredIDs(filter *EquivalenceFilter, featurePath string, mutations []Mutation) map[string]bool {
+	ids := map[string]bool{}
+	if filter == nil {
+		return ids
+	}
+	for _, mutation := range mutations {
+		if filterEntryMatch(filter, featurePath, mutation) != nil {
+			ids[mutation.ID] = true
+		}
+	}
+	return ids
+}
+
+type EquivalentView struct {
+	ID            string `json:"ID"`
+	Path          string `json:"Path"`
+	Description   string `json:"Description"`
+	Original      string `json:"Original"`
+	Mutated       string `json:"Mutated"`
+	Class         string `json:"Class"`
+	Justification string `json:"Justification"`
+	Invalidation  string `json:"Invalidation"`
+	Scenario      int    `json:"scenario"`
+}
+
+func equivalentView(mutation Mutation, entry *EquivalenceEntry) EquivalentView {
+	return EquivalentView{
+		ID:            mutation.ID,
+		Path:          mutation.Path,
+		Description:   mutation.Description,
+		Original:      mutation.Original,
+		Mutated:       mutation.Mutated,
+		Class:         entry.Class,
+		Justification: entry.Justification,
+		Invalidation:  entry.Invalidation,
+		Scenario:      mutation.Scenario,
+	}
+}
+
+func stampHash(cleaned string, filterHash string) string {
+	if filterHash != "" {
+		return hashString(cleaned + "\n# equivalence-filter: " + filterHash)
+	}
+	return hashString(cleaned)
+}
